{
  "display_information": {
    "name": "Wasabi Tarot",
    "description": "The Midnight Parlor: finite shared tarot rituals"
  },
  "features": {
    "bot_user": {
      "display_name": "Wasabi Tarot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/tarot",
        "description": "Draw, shuffle, or schedule tarot",
        "usage_hint": "help",
        "url": "https://YOUR-HOST/slack/commands",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR-HOST/slack/interactions"
    }
  }
}
