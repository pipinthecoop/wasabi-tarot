SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
DATABASE_PATH=/data/tarot.sqlite3
REGISTRY_PATH=/app/registry.json
PORT=8080
RUN_WORKER=1
# Public card fronts: e.g. https://your-host/assets/decks (includes CRT GIF fronts and PNG fallbacks)
ART_BASE_URL=
THEME_PATH=/app/theme.json
# Public theme/back art: e.g. https://your-host/assets/theme (separate from ART_BASE_URL)
THEME_ASSET_BASE_URL=
PUBLIC_BASE_URL=
ENABLE_APP_HOME=0
ENABLE_WEB_TABLE=0
ENABLE_WORK_OBJECTS=0
# CRT Slack fronts use GIF by default; set 0 to force PNGs for future readings.
ANIMATED_ART=1
# For a native Mac service, set BIND_HOST=127.0.0.1 (container default remains 0.0.0.0).
BIND_HOST=127.0.0.1
